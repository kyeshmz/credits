---
interface Props { active?: "credits" | "categories"; }
const { active } = Astro.props;
---
<header>
  <div class="left">
    <a class="brand" href="/"><h1>Startup Credits</h1></a><span class="slash"></span><p>An open-source wiki of startup credit programs</p>
  </div>
  <div class="right">
    <nav class="top-nav" aria-label="Primary">
      <a class:list={{ active: active === "credits" }} href="/">Credits</a>
      <a class:list={{ active: active === "categories" }} href="/categories">Categories</a>
    </nav>
    <a class="github" href="https://github.com/wholeearth/oss" aria-label="GitHub">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.74.08-.74 1.2.09 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.48 1 .11-.78.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.76.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.47 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"/></svg>
    </a>
    <div class="search-container"><button type="button" id="search-trigger" class="search-trigger" aria-label="Search" aria-haspopup="dialog" aria-controls="search-modal"><span class="search-trigger-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Search</span></span><span class="search-shortcut">Ctrl K</span></button></div>
    <button id="help" type="button">How to use</button>
  </div>
</header>
